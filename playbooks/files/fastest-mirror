#!/usr/bin/env python3
"""Picks the fastest Ubuntu mirror from this machine, for apt_mirror: auto.

  fastest-mirror RELEASE CACHE_FILE CANDIDATE_URL...

Candidates are the given URLs plus the mirrors Ubuntu suggests for this
location (mirrors.ubuntu.com/mirrors.txt). A mirror qualifies when it serves
RELEASE and RELEASE-security; the qualifying ones with the lowest latency are
then timed downloading the same package index, one at a time so they do not
share the link, and the fastest wins. Prints its URL.

The choice is kept in CACHE_FILE for a day and reused while it still answers,
so reruns keep the same mirror (and apt its package lists)."""
import concurrent.futures
import os
import sys
import time
import urllib.request

LATENCY_TIMEOUT = 5      # s, per index request in the first round
SPEED_BYTES = 2 << 20    # read up to this much of the package index
SPEED_TIME = 6           # s, per mirror in the second round
FINALISTS = 4
MAX_AGE = 24 * 3600


def get(url, timeout, limit=None, deadline=None):
    """Bytes read and seconds taken; raises on HTTP errors and timeouts."""
    start = time.monotonic()
    n = 0
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "ai-lab"}), timeout=timeout) as r:
        while chunk := r.read(65536):
            n += len(chunk)
            if (limit and n >= limit) or (deadline and time.monotonic() - start > deadline):
                break
    return n, time.monotonic() - start


def serves(base, release):
    """Latency of the mirror's release index, or None if it does not serve both pockets."""
    try:
        _, t = get(f"{base}/dists/{release}/InRelease", LATENCY_TIMEOUT)
        get(f"{base}/dists/{release}-security/InRelease", LATENCY_TIMEOUT)
        return t
    except Exception:
        return None


def speed(base, release):
    try:
        n, t = get(f"{base}/dists/{release}/main/binary-amd64/Packages.gz", SPEED_TIME, SPEED_BYTES, SPEED_TIME)
        return n / t
    except Exception:
        return 0


def suggested():
    try:
        n = urllib.request.urlopen("http://mirrors.ubuntu.com/mirrors.txt", timeout=LATENCY_TIMEOUT).read()
        return n.decode().split()
    except Exception:
        return []


def main():
    release, cache, given = sys.argv[1], sys.argv[2], sys.argv[3:]
    try:
        if time.time() - os.path.getmtime(cache) < MAX_AGE:
            with open(cache) as f:
                url = f.read().strip()
            if url and serves(url, release) is not None:
                print(url)
                return
    except OSError:
        pass

    candidates = list(dict.fromkeys(u.rstrip("/") for u in given + suggested()))
    with concurrent.futures.ThreadPoolExecutor(len(candidates)) as pool:
        latency = dict(zip(candidates, pool.map(lambda u: serves(u, release), candidates)))
    alive = sorted((t, u) for u, t in latency.items() if t is not None)
    if not alive:
        sys.exit(f"no Ubuntu mirror serving {release} answered: {' '.join(candidates)}")
    rates = {u: speed(u, release) for _, u in alive[:FINALISTS]}
    best = max(rates, key=rates.get)
    for u, r in sorted(rates.items(), key=lambda x: -x[1]):
        print(f"{r / 1e6:6.2f} MB/s  {u}", file=sys.stderr)

    os.makedirs(os.path.dirname(cache) or ".", exist_ok=True)
    with open(cache, "w") as f:
        f.write(best + "\n")
    print(best)


if __name__ == "__main__":
    main()
