#!/usr/bin/env python3
"""InfiniBand port counters of this tray's NICs for node_exporter's textfile
collector, under the names node_exporter's own infiniband collector uses
(node_infiniband_port_data_{transmitted,received}_bytes_total{device,port}),
so queries and dashboards written for real HCAs work unchanged.

Each GPU has its own NIC, mlx5_<gpu>; its traffic is what the fake NCCL sent
between NVLink partitions, counted in the tray's occupancy file (struct
fg_gpu_net in fakegpu/occupancy.h)."""
import os
import struct
import sys

STATE = sys.argv[1] if len(sys.argv) > 1 else "/var/lib/fakegpu/telemetry/occupancy"
OUT = sys.argv[2] if len(sys.argv) > 2 else "/var/lib/prometheus/node-exporter/infiniband.prom"
NICS = int(sys.argv[3]) if len(sys.argv) > 3 else 4
# struct fg_occupancy: gpu[8] x 56 bytes, proc[128] x 16, pidns[128] x 8, reset[8] x 16, net[8] x 16
NET = 8 * 56 + 128 * 16 + 128 * 8 + 8 * 16

try:
    with open(STATE, "rb") as f:
        data = f.read()
except FileNotFoundError:
    data = b""
lines = []
for name, field, help_ in (("transmitted", 0, "Number of data octets transmitted on all links"),
                           ("received", 1, "Number of data octets received on all links")):
    metric = f"node_infiniband_port_data_{name}_bytes_total"
    lines += [f"# HELP {metric} {help_}", f"# TYPE {metric} counter"]
    for nic in range(NICS):
        off = NET + nic * 16 + field * 8
        value = struct.unpack_from("<Q", data, off)[0] if len(data) >= off + 8 else 0
        lines.append(f'{metric}{{device="mlx5_{nic}",port="1"}} {value}')
tmp = OUT + ".tmp"
with open(tmp, "w") as f:
    f.write("\n".join(lines) + "\n")
os.replace(tmp, OUT)
