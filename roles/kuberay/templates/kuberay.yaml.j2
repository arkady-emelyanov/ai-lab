# {{ ansible_managed }}
# KubeRay: the operator and the API server from KubeRay's charts, its
# dashboard and History Server (no charts upstream), all on the
# control-plane node like the lab's other add-ons; Ray's own pods run on the
# trays.
{% set on_controller = {'nodeSelector': {'node-role.kubernetes.io/control-plane': 'true'},
                        'tolerations': [{'key': 'CriticalAddonsOnly', 'operator': 'Exists'}]} %}
apiVersion: v1
kind: Namespace
metadata:
  name: {{ kuberay_namespace }}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: kuberay-operator
  namespace: kube-system
spec:
  repo: {{ kuberay_chart_repo }}
  chart: kuberay-operator
  version: {{ kuberay_version }}
  targetNamespace: {{ kuberay_namespace }}
  # The chart's requests equal its limits (512 MiB); it uses about 25 MiB.
  valuesContent: |-
    {{ on_controller | combine({'resources': {'limits': {'cpu': '100m', 'memory': '512Mi'},
                                              'requests': {'cpu': '20m', 'memory': '64Mi'}}}) | to_json }}
---
# API server V2: Kubernetes' own API for Ray's resources, their events and
# the Ray dashboards of KubeRay's services, which the dashboard calls from
# the browser. No security proxy (a shared token in front of it): the lab
# serves it without authentication, as the dashboard. Its chart requests
# 300 MiB; it uses about 10 MiB.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: kuberay-apiserver
  namespace: kube-system
spec:
  repo: {{ kuberay_chart_repo }}
  chart: kuberay-apiserver
  version: {{ kuberay_version }}
  targetNamespace: {{ kuberay_namespace }}
  valuesContent: |-
    {{ on_controller | combine({'enableAPIServerV2': true, 'security': none,
                                'resources': {'limits': {'cpu': '500m', 'memory': '500Mi'},
                                              'requests': {'cpu': '20m', 'memory': '32Mi'}}}) | to_json }}
---
# Kueue manages every RayJob in the users' namespaces (their default queue)
# and requires shutdownAfterJobFinishes, so a job's Ray cluster gives its
# resources back when the job ends. The dashboard's job form leaves it
# unset; Kubernetes sets it on any RayJob created without it.
apiVersion: admissionregistration.k8s.io/v1
kind: MutatingAdmissionPolicy
metadata:
  name: rayjob-shutdown-after-finish
spec:
  matchConstraints:
    resourceRules:
      - apiGroups: [ray.io]
        apiVersions: [v1]
        operations: [CREATE]
        resources: [rayjobs]
  matchConditions:
    - name: keeps-cluster
      expression: "!has(object.spec.shutdownAfterJobFinishes) || !object.spec.shutdownAfterJobFinishes"
  failurePolicy: Fail
  reinvocationPolicy: Never
  mutations:
    - patchType: JSONPatch
      jsonPatch:
        expression: >-
          [JSONPatch{op: "add", path: "/spec/shutdownAfterJobFinishes", value: true}]
---
apiVersion: admissionregistration.k8s.io/v1
kind: MutatingAdmissionPolicyBinding
metadata:
  name: rayjob-shutdown-after-finish
spec:
  policyName: rayjob-shutdown-after-finish
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: kuberay-dashboard
  namespace: {{ kuberay_namespace }}
  labels: {app.kubernetes.io/name: kuberay-dashboard}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: kuberay-dashboard}
  template:
    metadata:
      labels: {app.kubernetes.io/name: kuberay-dashboard}
    spec:
      nodeSelector: {{ on_controller.nodeSelector | to_json }}
      tolerations: {{ on_controller.tolerations | to_json }}
      containers:
        - name: dashboard
          image: quay.io/kuberay/dashboard:v{{ kuberay_version }}
          env:
            # Where the browser finds the API server: the same origin, through
            # the ingress below.
            - {name: API_DOMAIN, value: "http://{{ kuberay_fqdn }}"}
            - {name: DEFAULT_NAMESPACE, value: "{{ cluster_users[0].name }}"}
            # The History pages: the dashboard's server proxies them
            # (/api/historyserver/) to the History Server, through the
            # ingress below, which fixes their paths.
            - {name: HISTORYSERVER_DOMAIN, value: "http://{{ kuberay_fqdn }}/historyserver"}
            - {name: NEXT_TELEMETRY_DISABLED, value: "1"}
          ports:
            - {name: http, containerPort: 3000}
          readinessProbe:
            httpGet: {path: /api/config, port: http}
          resources:
            requests: {cpu: 20m, memory: 64Mi}
            limits: {memory: 256Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: kuberay-dashboard
  namespace: {{ kuberay_namespace }}
spec:
  selector: {app.kubernetes.io/name: kuberay-dashboard}
  ports:
    - {name: http, port: 80, targetPort: http}
---
# One plain-HTTP name for both: Kubernetes API paths go to the API server,
# the rest (pages and the dashboard's own /api/config) to the dashboard.
#
# A job's Logs link on the dashboard's Jobs page is its cluster's Ray
# dashboard (/api/v1/namespaces/<ns>/services/<cluster>-head-svc:8265/proxy/
# #/jobs/<id>), which is gone with the cluster: the API server answers 404.
# Then HAProxy sends the browser to the cluster's history in Ray's dashboard
# (ray-history below), on its Jobs page: the History Server finds a job by
# its Ray job ID only, not by the submission ID in the link (also on
# KubeRay's main branch).
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: kuberay
  namespace: {{ kuberay_namespace }}
  annotations:
    haproxy.org/backend-config-snippet: |
      http-request set-var(txn.ray_ns) path,field(5,/) if { path_reg ^/api/v1/namespaces/[^/]+/services/[^/]+-head-svc:8265/proxy/$ }
      http-request set-var(txn.ray_cluster) path,field(7,/),regsub(-head-svc:8265$,) if { var(txn.ray_ns) -m found }
      http-response redirect location http://{{ kuberay_history_fqdn }}/open/%[var(txn.ray_ns)]/%[var(txn.ray_cluster)] code 302 if { var(txn.ray_ns) -m found } { status 404 }
spec:
  ingressClassName: haproxy
  rules:
    - host: {{ kuberay_fqdn }}
      http:
        paths:
{% for path in ['/apis/ray.io/', '/apis/events.k8s.io/', '/api/v1/'] %}
          - path: {{ path }}
            pathType: Prefix
            backend:
              service: {name: kuberay-apiserver-service, port: {name: http}}
{% endfor %}
          - path: /
            pathType: Prefix
            backend:
              service: {name: kuberay-dashboard, port: {name: http}}
---
# ---- History Server -------------------------------------------------------------
# Where the collectors (a sidecar in each Ray pod that keeps its history)
# upload to and the History Server reads from: the RustFS bucket, with the
# keys of its own S3 user, in every namespace Ray clusters run in.
{% for namespace in [kuberay_namespace] + cluster_users | map(attribute='name') | list %}
apiVersion: v1
kind: Secret
metadata:
  name: ray-history-s3
  namespace: {{ namespace }}
stringData:
  STORAGE_BACKEND: s3
  S3_ENDPOINT: "{{ storage_host }}:{{ rustfs_port }}"
  S3DISABLE_SSL: "true"
  S3FORCE_PATH_STYLE: "true"
  S3_REGION: us-east-1
  S3_BUCKET: "{{ kuberay_history_bucket }}"
  AWS_ACCESS_KEY_ID: ray-history
  AWS_SECRET_ACCESS_KEY: "{{ kuberay_history_secret_key }}"
---
{% endfor %}
apiVersion: v1
kind: ServiceAccount
metadata:
  name: historyserver
  namespace: {{ kuberay_namespace }}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: kuberay-historyserver
rules:
  - apiGroups: [ray.io]
    resources: [rayclusters]
    verbs: [get, list]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: kuberay-historyserver
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: kuberay-historyserver
subjects:
  - {kind: ServiceAccount, name: historyserver, namespace: {{ kuberay_namespace }}}
---
# Serves finished clusters only (no proxying to live ones, upstream's
# default). It parses a session when it is opened and caches a few; the
# lab's clusters are small.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: historyserver
  namespace: {{ kuberay_namespace }}
  labels: {app.kubernetes.io/name: historyserver}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: historyserver}
  template:
    metadata:
      labels: {app.kubernetes.io/name: historyserver}
    spec:
      serviceAccountName: historyserver
      nodeSelector: {{ on_controller.nodeSelector | to_json }}
      tolerations: {{ on_controller.tolerations | to_json }}
      containers:
        - name: historyserver
          image: quay.io/kuberay/historyserver:v{{ kuberay_version }}
          args: [--session-cache-max-memory=256Mi]
          envFrom:
            - secretRef: {name: ray-history-s3}
          ports:
            - {name: http, containerPort: 8080}
          readinessProbe:
            httpGet: {path: /readz, port: http}
          resources:
            requests: {cpu: 20m, memory: 64Mi}
            limits: {memory: 768Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: historyserver
  namespace: {{ kuberay_namespace }}
spec:
  selector: {app.kubernetes.io/name: historyserver}
  ports:
    - {name: http, port: 8080, targetPort: http}
---
# The History Server through the dashboard's name, for the dashboard's
# server. KubeRay 1.7.1's dashboard opens a finished cluster at
# /enter_cluster/<namespace>/<cluster>/<session>, its History Server expects
# /enter_cluster/<namespace>/<kind>/<name>/<session> (also on KubeRay's main
# branch): HAProxy adds the kind, raycluster.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: kuberay-historyserver
  namespace: {{ kuberay_namespace }}
  annotations:
    haproxy.org/path-rewrite: |
      ^/historyserver/enter_cluster/([^/]+)/([^/]+)/([^/]+)$ /enter_cluster/\1/raycluster/\2/\3
      ^/historyserver/(.*)$ /\1
spec:
  ingressClassName: haproxy
  rules:
    - host: {{ kuberay_fqdn }}
      http:
        paths:
          - path: /historyserver/
            pathType: Prefix
            backend:
              service: {name: historyserver, port: {name: http}}
---
# ---- Ray's dashboard for finished clusters --------------------------------------
# Ray's own dashboard with the History Server as its backend (upstream's way
# to look at a finished cluster): it sends every request to the History
# Server and serves its own pages where the History Server has none. A
# cookie set by the History Server selects the cluster.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ray-history
  namespace: {{ kuberay_namespace }}
  labels: {app.kubernetes.io/name: ray-history}
spec:
  replicas: 1
  selector:
    matchLabels: {app.kubernetes.io/name: ray-history}
  template:
    metadata:
      labels: {app.kubernetes.io/name: ray-history}
    spec:
      nodeSelector: {{ on_controller.nodeSelector | to_json }}
      tolerations: {{ on_controller.tolerations | to_json }}
      containers:
        - name: ray
          image: {{ kuberay_history_ray_image }}
          # Not --block: ray start would stay, only to wait (200 MiB); the
          # liveness probe restarts the pod if Ray stops. Ray's dashboard has
          # no switch for fewer modules: they are idle here.
          command: [bash, -c]
          args:
            - >-
              ray start --head --num-cpus=0 --object-store-memory=80000000 --include-log-monitor=false
              --disable-usage-stats --dashboard-host=0.0.0.0 --dashboard-port=8265
              --proxy-server-url=http://historyserver.{{ kuberay_namespace }}.svc.cluster.local:8080
              && exec sleep infinity
          ports:
            - {name: http, containerPort: 8265}
          readinessProbe:
            httpGet: {path: /api/gcs_healthz, port: http}
            initialDelaySeconds: 10
          livenessProbe:
            httpGet: {path: /api/gcs_healthz, port: http}
            initialDelaySeconds: 60
            periodSeconds: 30
          resources:
            requests: {cpu: 50m, memory: 256Mi}
            limits: {memory: 1Gi}
---
apiVersion: v1
kind: Service
metadata:
  name: ray-history
  namespace: {{ kuberay_namespace }}
spec:
  selector: {app.kubernetes.io/name: ray-history}
  ports:
    - {name: http, port: 80, targetPort: http}
---
# The same History Server pods for /open/ only: HAProxy keeps a service's
# rules per backend, and these differ from the dashboard's.
apiVersion: v1
kind: Service
metadata:
  name: ray-history-open
  namespace: {{ kuberay_namespace }}
spec:
  selector: {app.kubernetes.io/name: historyserver}
  ports:
    - {name: http, port: 8080, targetPort: http}
---
# http://ray-history.<controller address>.nip.io: Ray's dashboard; without a
# cluster selected, the History Server's list of clusters (/select_cluster).
# /open/<namespace>/<cluster> selects the cluster's latest session (the
# History Server's /enter_cluster, which sets the cookies) and goes on to
# the dashboard's Jobs page: where a finished job's Logs link lands.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ray-history
  namespace: {{ kuberay_namespace }}
  annotations:
    haproxy.org/backend-config-snippet: |
      http-request redirect location /select_cluster code 302 if { path / } !{ req.cook(cluster_name) -m found }
spec:
  ingressClassName: haproxy
  rules:
    - host: {{ kuberay_history_fqdn }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: {name: ray-history, port: {name: http}}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: ray-history-open
  namespace: {{ kuberay_namespace }}
  annotations:
    haproxy.org/backend-config-snippet: |
      http-request replace-path ^/open/([^/]+)/([^/]+)/?$ /enter_cluster/\1/raycluster/\2
      http-response set-var(txn.entered) bool(1) if { status 200 }
      http-response set-status 302 if { var(txn.entered) -m bool }
      http-response set-header Location "/#/jobs" if { var(txn.entered) -m bool }
spec:
  ingressClassName: haproxy
  rules:
    - host: {{ kuberay_history_fqdn }}
      http:
        paths:
          - path: /open/
            pathType: Prefix
            backend:
              service: {name: ray-history-open, port: {name: http}}
