#!/usr/bin/env python3
# {{ ansible_managed }}
"""runai-api METHOD PATH [JSON]: one call to the Run:ai control plane's REST
API as its administrator, e.g. runai-api GET /v1/k8s/clusters. Prints the
response body; exits 1 on an HTTP error or no answer (with the reason)."""
import json
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request

URL = "https://{{ runai_fqdn }}"
CA = "{{ runai_ca_path }}"
USER = "{{ runai_admin_email }}"
PASSWORD_FILE = "{{ runai_admin_password_path }}"


def call(method, url, data=None, headers=None):
    req = urllib.request.Request(url, data=data, method=method, headers=headers or {})
    with urllib.request.urlopen(req, context=ssl.create_default_context(cafile=CA), timeout=60) as resp:
        return resp.read().decode()


def main():
    if len(sys.argv) not in (3, 4):
        sys.exit(__doc__)
    method, path = sys.argv[1].upper(), sys.argv[2]
    body = sys.argv[3].encode() if len(sys.argv) == 4 else None
    with open(PASSWORD_FILE) as f:
        password = f.read().strip()
    try:
        token = json.loads(call("POST", URL + "/auth/realms/runai/protocol/openid-connect/token",
                                urllib.parse.urlencode({"grant_type": "password", "client_id": "runai",
                                                        "username": USER, "password": password,
                                                        "scope": "openid"}).encode(),
                                {"Content-Type": "application/x-www-form-urlencoded"}))["access_token"]
        headers = {"Authorization": "Bearer " + token, "Accept": "application/json"}
        if body is not None:
            headers["Content-Type"] = "application/json"
        print(call(method, URL + path, body, headers))
    except urllib.error.HTTPError as e:
        sys.exit(f"{method} {path}: HTTP {e.code} {e.read().decode(errors='replace')[:500]}")
    except (urllib.error.URLError, OSError, KeyError, ValueError) as e:
        sys.exit(f"{method} {path}: {e}")


main()
