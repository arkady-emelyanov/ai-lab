# {{ ansible_managed }}
# What Run:ai expects in a Kubernetes cluster before it is installed, as a
# GPU cluster would have it, besides the ingress controller (HAProxy, the one
# Run:ai recommends; a k3s add-on): the Prometheus operator
# (kube-prometheus-stack; Run:ai runs its own Prometheus through it) and
# NVIDIA's DCGM exporter (objects.yaml). Controllers run on the
# control-plane node, like the lab's other add-ons.
# Only the operator and the cluster-state exporters: Run:ai creates its own
# Prometheus (namespace runai), which scrapes the ServiceMonitors here.
# The lab's node_exporter already runs on every instance.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: kube-prometheus-stack
  namespace: kube-system
spec:
  repo: https://prometheus-community.github.io/helm-charts
  chart: kube-prometheus-stack
  version: {{ kube_prometheus_stack_chart_version }}
  targetNamespace: monitoring
  createNamespace: true
  valuesContent: |-
    grafana: {enabled: false}
    alertmanager: {enabled: false}
    prometheus: {enabled: false}
    nodeExporter: {enabled: false}
    defaultRules: {create: false}
    # Part of the k3s server, not separate components.
    kubeApiServer: {enabled: false}
    kubeControllerManager: {enabled: false}
    kubeScheduler: {enabled: false}
    kubeProxy: {enabled: false}
    kubeEtcd: {enabled: false}
    coreDns: {enabled: false}
    # Container CPU and memory from the kubelets, with a token of its own
    # (objects.yaml): the chart's own token comes with its Prometheus.
    kubelet:
      serviceMonitor:
        authorization:
          type: Bearer
          credentials: {name: kubelet-scraper-token, key: token}
    prometheusOperator:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
      admissionWebhooks:
        patch:
          nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
          tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
    kube-state-metrics:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
