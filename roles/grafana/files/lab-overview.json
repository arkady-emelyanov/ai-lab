{
  "title": "Lab overview",
  "uid": "ai-lab-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "GPU utilisation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_utilization_gpu_ratio * on(uuid, instance) group_left(index) nvidia_smi_gpu_info",
          "legendFormat": "{{instance}} GPU {{index}}",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "GPU memory used",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_memory_used_bytes * on(uuid, instance) group_left(index) nvidia_smi_gpu_info",
          "legendFormat": "{{instance}} GPU {{index}}",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "GPU power",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_power_draw_watts * on(uuid, instance) group_left(index) nvidia_smi_gpu_info",
          "legendFormat": "{{instance}} GPU {{index}}",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "GPU temperature",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nvidia_smi_temperature_gpu * on(uuid, instance) group_left(index) nvidia_smi_gpu_info",
          "legendFormat": "{{instance}} GPU {{index}}",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Processes on GPUs",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (instance) (nvidia_smi_compute_apps)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "NVL8 domain power",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(nvidia_smi_power_draw_watts)",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "JuiceFS throughput (/pfs)",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(juicefs_fuse_read_size_bytes_sum[1m])) or sum by (instance) (rate(juicefs_fuse_written_size_bytes_sum[1m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "id": 7
    },
    {
      "type": "state-timeline",
      "title": "Trays: BMC power state (out of band) vs GPU exporter (in band)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "On",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "Off",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "reachable",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "unreachable",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "up",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "down",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "expr": "idrac_system_power_on",
          "legendFormat": "{{tray}} power (BMC)",
          "refId": "A"
        },
        {
          "expr": "up{job=\"redfish\"}",
          "legendFormat": "{{tray}} BMC",
          "refId": "B"
        },
        {
          "expr": "up{job=\"gpu\"}",
          "legendFormat": "{{instance}} GPU exporter",
          "refId": "C"
        }
      ],
      "id": 8
    }
  ],
  "tags": [
    "ai-lab"
  ]
}
