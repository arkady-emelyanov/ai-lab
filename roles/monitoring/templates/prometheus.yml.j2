# {{ ansible_managed }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s

# Scheduler-neutral series (sched_*) for the dashboards, from Slurm or k3s.
rule_files:
  - /etc/prometheus/sched-rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: [localhost:9090]

  - job_name: node
    static_configs:
      - targets:
{% for host in groups['cluster'] %}
          - {{ host }}:9100
{% endfor %}

  - job_name: gpu
    scrape_interval: 5s
    static_configs:
      - targets:
{% for host in groups['workers'] %}
          - {{ host }}:{{ gpu_exporter_port }}
{% endfor %}
        labels:
          nvl_domain: {{ nvl_domain_name }}

  - job_name: juicefs
    static_configs:
      - targets:
{% for host in groups['cluster'] %}
          - {{ host }}:9567
{% endfor %}

{% if scheduler == 'slurm' %}
  - job_name: slurm
    scrape_interval: 30s
    static_configs:
      - targets: [localhost:{{ slurm_exporter_port }}]
{% else %}
  - job_name: kube-state-metrics
    static_configs:
      - targets: ['{{ groups["controller"][0] }}:{{ ksm_node_port }}']
{% endif %}

  # Out of band: each tray's BMC through the Redfish exporter (target = BMC).
  - job_name: redfish
    scrape_interval: 30s
    scrape_timeout: 20s
    static_configs:
{% for bmc in groups['tray_bmc'] %}
      - targets: [{{ bmc }}]
        labels:
          tray: {{ hostvars[bmc].bmc_tray }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__address__]
        target_label: instance
      - target_label: __address__
        replacement: localhost:{{ redfish_exporter_port }}

  - job_name: nvlink
    static_configs:
      - targets:
{% for host in groups['nvswitch'] %}
          - {{ host }}:{{ nmxc_metrics_port }}
{% endfor %}
        labels:
          nvl_domain: {{ nvl_domain_name }}
