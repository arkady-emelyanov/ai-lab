# {{ ansible_managed }}
# Scheduler-neutral series for the dashboards, the same names whatever runs
# the workloads ({{ scheduler }} here):
#   sched_gpus, sched_gpus_alloc        GPUs schedulable / allocated
#   sched_node_gpus_alloc{node}         allocated GPUs per tray
#   sched_user_gpus{user}               allocated GPUs per user
#   sched_jobs{state}                   jobs by state (RUNNING, PENDING, ...)
#   sched_nodes{state}                  trays by scheduler state
groups:
  - name: sched
    rules:
{% if scheduler == 'slurm' %}
      - record: sched_gpus
        expr: sum(slurm_partition_gpus)
      - record: sched_gpus_alloc
        expr: sum(slurm_partition_gpus_alloc)
      - record: sched_node_gpus_alloc
        expr: sum by (node) (slurm_node_gpus_alloc)
      - record: sched_user_gpus
        expr: sum by (user) (slurm_job_gpus)
      - record: sched_jobs
        expr: sum by (state) (slurm_account_job_state_total)
      - record: sched_nodes
        expr: sum by (state) (slurm_node_count_per_state)
{% else %}
{% set users = cluster_users | map(attribute='name') | join('|') %}
{% set running_gpus = 'kube_pod_container_resource_requests{resource="nvidia_com_gpu"} * on (namespace, pod) group_left () (kube_pod_status_phase{phase="Running"} == 1)' %}
      - record: sched_gpus
        expr: sum(kube_node_status_allocatable{resource="nvidia_com_gpu"})
      - record: sched_gpus_alloc
        expr: sum({{ running_gpus }}) or vector(0)
      - record: sched_node_gpus_alloc
        expr: >-
          sum by (node) ({{ running_gpus }})
          or sum by (node) (kube_node_status_allocatable{resource="nvidia_com_gpu"}) * 0
      - record: sched_user_gpus
        expr: label_replace(sum by (namespace) ({{ running_gpus }}), "user", "$1", "namespace", "(.*)")
      # Jobs in user namespaces (JobSets run as Jobs); Kueue keeps queued
      # jobs suspended.
      - record: sched_jobs
        expr: label_replace(count(kube_job_status_active{namespace=~"{{ users }}"} > 0), "state", "RUNNING", "", "")
      - record: sched_jobs
        expr: label_replace(count(kube_job_status_suspended{namespace=~"{{ users }}"} == 1), "state", "PENDING", "", "")
      - record: sched_jobs
        expr: label_replace(count(kube_job_status_succeeded{namespace=~"{{ users }}"} > 0), "state", "COMPLETED", "", "")
      - record: sched_jobs
        expr: label_replace(count(kube_job_status_failed{namespace=~"{{ users }}"} > 0), "state", "FAILED", "", "")
      - record: sched_nodes
        expr: >-
          label_replace(count(kube_node_status_condition{condition="Ready", status="true", node=~"{{ groups['workers'] | join('|') }}"} == 1),
          "state", "READY", "", "")
      - record: sched_nodes
        expr: >-
          label_replace(count(kube_node_status_condition{condition="Ready", status="true", node=~"{{ groups['workers'] | join('|') }}"} == 0),
          "state", "NOT_READY", "", "")
{% endif %}
