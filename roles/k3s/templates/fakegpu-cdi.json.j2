{#- CDI 0.6.0: one device per GPU, named by index and by UUID (the device
    plugin allocates by UUID). -#}
{%- set devices = [] -%}
{%- for idx, uuid in gpu_list -%}
{%-   for name in [idx, uuid] -%}
{%-     set _ = devices.append({'name': name, 'containerEdits': {'deviceNodes': [{'path': '/dev/nvidia' ~ idx}]}}) -%}
{%-   endfor -%}
{%- endfor -%}
{#- EP_SUPPRESS_NCCL_CHECK: DeepEP (in vLLM's image) refuses a second libnccl
    in the process, the preloaded stub next to the wheel's own copy. -#}
{%- set ro = ['bind', 'ro'] -%}
{{ {
  'cdiVersion': '0.6.0',
  'kind': 'nvidia.com/gpu',
  'devices': devices,
  'containerEdits': {
    'deviceNodes': [{'path': '/dev/nvidiactl'}],
    'env': ['LD_PRELOAD=' ~ preload, 'LD_LIBRARY_PATH=' ~ fakegpu_prefix ~ '/lib/fakegpu',
            'EP_SUPPRESS_NCCL_CHECK=1'],
    'mounts': [
      {'hostPath': fakegpu_prefix ~ '/lib/fakegpu', 'containerPath': fakegpu_prefix ~ '/lib/fakegpu', 'options': ro},
      {'hostPath': fakegpu_prefix ~ '/bin/nvidia-smi', 'containerPath': '/usr/bin/nvidia-smi', 'options': ro},
      {'hostPath': '/etc/fakegpu.conf', 'containerPath': '/etc/fakegpu.conf', 'options': ro},
      {'hostPath': sideband_tray_path, 'containerPath': sideband_tray_path, 'options': ro},
      {'hostPath': telemetry_tray_path, 'containerPath': telemetry_tray_path, 'options': ['bind', 'rw']},
    ],
  },
} | to_nice_json }}
