# {{ ansible_managed }}
# Cluster add-ons, installed by k3s' Helm controller. Controllers run on the
# control-plane node (tainted CriticalAddonsOnly); per-node agents on the trays.
# The toleration only allows the control-plane node; the nodeSelector makes it
# the only one, so no controller competes with GPU jobs on a tray.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: node-feature-discovery
  namespace: kube-system
spec:
  repo: https://kubernetes-sigs.github.io/node-feature-discovery/charts
  chart: node-feature-discovery
  version: {{ nfd_chart_version }}
  targetNamespace: node-feature-discovery
  createNamespace: true
  valuesContent: |-
    master:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
    gc:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
    worker:
      nodeSelector: {nvidia.com/gpu.present: "true"}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: kueue
  namespace: kube-system
spec:
  chart: oci://registry.k8s.io/kueue/charts/kueue
  version: {{ kueue_chart_version }}
  targetNamespace: kueue-system
  createNamespace: true
  valuesContent: |-
    controllerManager:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: jobset
  namespace: kube-system
spec:
  chart: oci://registry.k8s.io/jobset/charts/jobset
  version: {{ jobset_chart_version }}
  targetNamespace: jobset-system
  createNamespace: true
  valuesContent: |-
    controller:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
---
# Cluster state for the controller's Prometheus (GPU requests per pod, node
# allocatable, jobs), on a NodePort of the control-plane node.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: kube-state-metrics
  namespace: kube-system
spec:
  repo: https://prometheus-community.github.io/helm-charts
  chart: kube-state-metrics
  version: {{ ksm_chart_version }}
  targetNamespace: kube-system
  valuesContent: |-
    service:
      type: NodePort
      nodePort: {{ ksm_node_port }}
    nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
    tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
