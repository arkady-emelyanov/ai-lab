# {{ ansible_managed }}
# Cluster add-ons, installed by k3s' Helm controller. Controllers run on the
# control-plane node (tainted CriticalAddonsOnly); per-node agents on the trays.
# The toleration only allows the control-plane node; the nodeSelector makes it
# the only one, so no controller competes with GPU jobs on a tray.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: node-feature-discovery
  namespace: kube-system
spec:
  repo: https://kubernetes-sigs.github.io/node-feature-discovery/charts
  chart: node-feature-discovery
  version: {{ nfd_chart_version }}
  targetNamespace: node-feature-discovery
  createNamespace: true
  valuesContent: |-
    master:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
    gc:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
    worker:
      nodeSelector: {nvidia.com/gpu.present: "true"}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: kueue
  namespace: kube-system
spec:
  chart: oci://registry.k8s.io/kueue/charts/kueue
  version: {{ kueue_chart_version }}
  targetNamespace: kueue-system
  createNamespace: true
  valuesContent: |-
    controllerManager:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
      # The chart requests its limits (512 MiB); Kueue uses about 150 MiB here.
      manager:
        resources:
          limits: {cpu: "2", memory: 512Mi}
          requests: {cpu: 100m, memory: 192Mi}
{% if nvidia_dra | bool %}
    # The chart's configuration, plus DRA: a ComputeDomain's IMEX channel
    # (a pod's claim on its DeviceClass) counts as nvidia.com/imex-channel
    # against the ClusterQueue's quota (queues.yaml.j2).
    managerConfig:
      controllerManagerConfigYaml: |-
        apiVersion: config.kueue.x-k8s.io/v1beta2
        kind: Configuration
        health:
          healthProbeBindAddress: :8081
        metrics:
          bindAddress: :8443
        webhook:
          port: 9443
        leaderElection:
          leaderElect: true
          resourceName: c1f6bfd2.kueue.x-k8s.io
        controller:
          groupKindConcurrency:
            Job.batch: 5
            Pod: 5
            Workload.kueue.x-k8s.io: 10
            LocalQueue.kueue.x-k8s.io: 5
            Cohort.kueue.x-k8s.io: 1
            ClusterQueue.kueue.x-k8s.io: 5
            ResourceFlavor.kueue.x-k8s.io: 1
        clientConnection:
          qps: 300
          burst: 500
        integrations:
          frameworks: [batch/job, kubeflow.org/mpijob, ray.io/rayjob, ray.io/rayservice, ray.io/raycluster,
                       jobset.x-k8s.io/jobset, workload.codeflare.dev/appwrapper, trainer.kubeflow.org/trainjob,
                       pod, deployment, statefulset, leaderworkerset.x-k8s.io/leaderworkerset]
        resources:
          deviceClassMappings:
            - name: nvidia.com/imex-channel
              deviceClassNames: [compute-domain-default-channel.nvidia.com]
{% endif %}
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: jobset
  namespace: kube-system
spec:
  chart: oci://registry.k8s.io/jobset/charts/jobset
  version: {{ jobset_chart_version }}
  targetNamespace: jobset-system
  createNamespace: true
  valuesContent: |-
    controller:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
---
# Ingress controller for the lab's web UIs: plain HTTP (KubeRay's dashboard),
# HTTPS only where a component requires it (Run:ai, its own certificate).
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: haproxy-ingress
  namespace: kube-system
spec:
  repo: https://haproxytech.github.io/helm-charts
  chart: kubernetes-ingress
  version: {{ haproxy_ingress_chart_version }}
  targetNamespace: haproxy-controller
  createNamespace: true
  valuesContent: |-
    controller:
      # One instance on the controller's own ports 80 and 443: the address
      # the lab's web UI names (*.<controller address>.nip.io) resolve to,
      # from the host and from pods.
      kind: DaemonSet
      daemonset:
        useHostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      # Ports below 1024 in the host's network namespace: as root (a pod
      # sysctl cannot open them with host networking).
      unprivileged: false
      containerPort: {http: 80, https: 443, stat: 1024}
      service:
        type: ClusterIP
      ingressClass: haproxy
      ingressClassResource:
        name: haproxy
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
      tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
      resources:
        requests: {cpu: 50m, memory: 64Mi}
---
# Cluster state for the controller's Prometheus (GPU requests per pod, node
# allocatable, jobs), on a NodePort of the control-plane node.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: kube-state-metrics
  namespace: kube-system
spec:
  repo: https://prometheus-community.github.io/helm-charts
  chart: kube-state-metrics
  version: {{ ksm_chart_version }}
  targetNamespace: kube-system
  valuesContent: |-
    service:
      type: NodePort
      nodePort: {{ ksm_node_port }}
    nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
    tolerations: [{key: CriticalAddonsOnly, operator: Exists}]
{% if nvidia_dra | bool %}
---
# NVIDIA's DRA driver for GPUs, unchanged, ComputeDomains only (IMEX channels
# and daemons for memory shared over NVLink between trays); GPUs stay with
# the lab's device plugin. Its kubelet plugin runs on the trays' fake driver
# root (roles/fakegpu): the fake NVML there reads the tray's configuration
# and GPU state through these variables. See docs/compute-domains.md.
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: nvidia-dra-driver-gpu
  namespace: kube-system
spec:
  chart: {{ nvidia_dra_chart }}
  version: {{ nvidia_dra_version }}
  targetNamespace: nvidia-dra-driver-gpu
  createNamespace: true
  valuesContent: |-
    nvidiaDriverRoot: {{ fakegpu_driver_root }}
    altProcDevices: {{ fakegpu_driver_root }}/proc/devices
    resources:
      gpus: {enabled: false}
      computeDomains: {enabled: true}
    controller:
      nodeSelector: {node-role.kubernetes.io/control-plane: "true"}
    kubeletPlugin:
      nodeSelector: {nvidia.com/gpu.present: "true"}
      containers:
        computeDomains:
          env:
            - {name: FAKEGPU_CONF, value: /driver-root/etc/fakegpu.conf}
            - {name: FAKEGPU_SIDEBAND_DIR, value: /driver-root/var/lib/fakegpu/sideband}
            - {name: FAKEGPU_STATE_PATH, value: /driver-root/var/lib/fakegpu/telemetry/occupancy}
{% endif %}
