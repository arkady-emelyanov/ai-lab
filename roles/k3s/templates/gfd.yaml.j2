# {{ ansible_managed }}
# NVIDIA GPU Feature Discovery on the trays: reads the GPUs through NVML and
# publishes nvidia.com/* node labels (product, memory, clique, ...) through
# Node Feature Discovery. The fake driver is mounted from the tray, as
# NVIDIA's container runtime would mount the real one.
apiVersion: v1
kind: Namespace
metadata:
  name: gpu-feature-discovery
---
# The tray's DMI product name: in a container, /sys/class/dmi is the host's.
apiVersion: v1
kind: ConfigMap
metadata:
  name: tray-dmi
  namespace: gpu-feature-discovery
data:
  product_name: "{{ tray_product_name }}"
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: gpu-feature-discovery
  namespace: gpu-feature-discovery
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: gpu-feature-discovery
rules:
  - apiGroups: [""]
    resources: [nodes]
    verbs: [get, list, watch]
  - apiGroups: [nfd.k8s-sigs.io]
    resources: [nodefeatures]
    verbs: [get, list, watch, create, update, delete]
  - apiGroups: [""]
    resources: [pods]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: gpu-feature-discovery
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: gpu-feature-discovery
subjects:
  - kind: ServiceAccount
    name: gpu-feature-discovery
    namespace: gpu-feature-discovery
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: gpu-feature-discovery
  namespace: gpu-feature-discovery
spec:
  selector:
    matchLabels: {app: gpu-feature-discovery}
  template:
    metadata:
      labels: {app: gpu-feature-discovery}
    spec:
      serviceAccountName: gpu-feature-discovery
      nodeSelector: {nvidia.com/gpu.present: "true"}
      priorityClassName: system-node-critical
      containers:
        - name: gpu-feature-discovery
          image: {{ gfd_image }}
          command: [gpu-feature-discovery]
          env:
            - name: NODE_NAME
              valueFrom: {fieldRef: {fieldPath: spec.nodeName}}
            - name: NAMESPACE
              valueFrom: {fieldRef: {fieldPath: metadata.namespace}}
            - name: POD_NAME
              valueFrom: {fieldRef: {fieldPath: metadata.name}}
            - name: LD_LIBRARY_PATH
              value: {{ fakegpu_prefix }}/lib/fakegpu
            - name: GFD_MACHINE_TYPE_FILE
              value: /etc/tray-dmi/product_name
          volumeMounts:
            - {name: fakegpu-lib, mountPath: "{{ fakegpu_prefix }}/lib/fakegpu", readOnly: true}
            - {name: fakegpu-conf, mountPath: /etc/fakegpu.conf, readOnly: true}
            - {name: sideband, mountPath: "{{ sideband_tray_path }}", readOnly: true}
{% for i in range(fakegpu_count) %}
            - {name: nvidia{{ i }}, mountPath: /dev/nvidia{{ i }}}
{% endfor %}
            - {name: output-dir, mountPath: /etc/kubernetes/node-feature-discovery/features.d}
            - {name: config, mountPath: /config}
            - {name: tray-dmi, mountPath: /etc/tray-dmi, readOnly: true}
      volumes:
        - {name: fakegpu-lib, hostPath: {path: "{{ fakegpu_prefix }}/lib/fakegpu", type: Directory}}
        - {name: fakegpu-conf, hostPath: {path: /etc/fakegpu.conf, type: File}}
        - {name: sideband, hostPath: {path: "{{ sideband_tray_path }}", type: Directory}}
{% for i in range(fakegpu_count) %}
        - {name: nvidia{{ i }}, hostPath: {path: /dev/nvidia{{ i }}, type: CharDevice}}
{% endfor %}
        - {name: output-dir, hostPath: {path: /etc/kubernetes/node-feature-discovery/features.d, type: DirectoryOrCreate}}
        - {name: config, emptyDir: {}}
        - {name: tray-dmi, configMap: {name: tray-dmi}}
